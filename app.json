{
  "expo": {
    "name": "夢想未來記帳本",
    "slug": "aimmora",
    "version": "0.95.0",
    "orientation": "portrait",
    "icon": "./assets/aimmora-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/aimmora-splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#004F38"
    },
    "ios": {
      "bundleIdentifier": "com.kuolunghuang.aimmora",
      "buildNumber": "95",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "en",
          "zh-Hant"
        ]
      }
    },
    "android": {
      "package": "com.kuolunghuang.aimmora",
      "versionCode": 95,
      "adaptiveIcon": {
        "backgroundColor": "#004F38",
        "foregroundImage": "./assets/aimmora-android-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/aimmora-favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "允許「夢想未來記帳本」存取相簿，讓你為夢想選擇代表圖片。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#087A50",
          "defaultChannel": "monthly-reminders"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "zh-Hant"
            ],
            "android": [
              "en",
              "zh-Hant"
            ]
          }
        }
      ]
    ],
    "locales": {
      "en": "./locales/en.json",
      "zh-Hant": "./locales/zh-Hant.json"
    },
    "extra": {
      "eas": {
        "projectId": "5c8ce6ae-f6df-4548-9f5f-ff5433620bda"
      }
    },
    "owner": "tom19760909"
  }
}
